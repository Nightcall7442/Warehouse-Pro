# ============================================================
# Warehouse Pro — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:port/dbname

# ── APP SECURITY ─────────────────────────────────────────────
# Generate with: openssl rand -base64 48
APP_SECRET=

# ── APP URL ──────────────────────────────────────────────────
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── REVERSE PROXY / RATE LIMITING ────────────────────────────
# Number of reverse proxies (nginx, Railway, Cloudflare, …) in front of the app.
# It decides which hop of X-Forwarded-For identifies the client:
#   0 — no proxy: proxy headers are ignored (they are spoofable) and the client is
#       identified by its TCP socket address. Correct for local development and for
#       a directly exposed process.
#   1 — one proxy: the last hop appended by that proxy is used. This is the right
#       value for a typical production deployment behind a single reverse proxy.
#   2+ — one entry per proxy in the chain (e.g. Cloudflare + nginx = 2).
# Setting this too high lets a client spoof its own address; too low buckets every
# client behind the proxy together, so rate limits fire for everyone at once.
TRUSTED_PROXY_COUNT=0

# ── STRIPE (optional — leave empty to disable billing) ────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_EXCLUSIVE_PRICE_ID=

# ── SMTP (optional — leave empty to disable email) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@warehousepro.app

# ── CRON SECRET (optional) ────────────────────────────────────
CRON_SECRET=

# ── BACKUPS ──────────────────────────────────────────────────
# Nightly database backup job.
#
# BACKUP_ENCRYPTION_KEY: 32 bytes of hex — generate with:
#   openssl rand -hex 32
# The job refuses to upload anything unless this is set; it never falls back to
# uploading an unencrypted dump. Keep the key somewhere other than the backup
# bucket: if it is lost, every existing backup is unrecoverable.
BACKUP_ENCRYPTION_KEY=
#
# BACKUP_SCHEDULE: 5-field cron expression, interpreted in UTC.
# Default is 0 2 * * * (02:00 UTC, daily).
BACKUP_SCHEDULE=0 2 * * *
#
# BACKUP_VERIFY_DATABASE_URL (optional): a scratch database that the restore
# check loads each fresh dump into to prove the dump is actually restorable.
# Leave empty to skip that check. It MUST NOT point at the production database —
# the check drops and recreates the schema of whatever it is pointed at.
BACKUP_VERIFY_DATABASE_URL=
#
# MYSQLDUMP_PATH / MYSQL_PATH (optional): override these when the MySQL client
# binaries are not on PATH, or to select a specific client build.
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
#
# The S3_* variables (S3_BUCKET, S3_REGION, S3_ACCESS_KEY, S3_SECRET_KEY) must
# also be set — they are the only destination the job uploads to. Without them
# there is nowhere for a backup to go.

# ── DATA RETENTION ───────────────────────────────────────────
# Nightly pruning of the tables that grow without bound. Runs in the same
# container as the backup, half an hour after it, so anything deleted is already
# in that night's dump.
#
# Days to keep. 0 or empty means keep forever for that table. A value below 7 is
# refused outright — that pattern is a misread variable far more often than a
# policy, and the cost of guessing wrong is deleted production data.
RETENTION_AGENT_LOCATIONS_DAYS=90
RETENTION_STOCK_MOVEMENTS_DAYS=730
RETENTION_AUDIT_LOG_DAYS=730
#
# RETENTION_SCHEDULE: 5-field cron, UTC. Keep it after BACKUP_SCHEDULE.
RETENTION_SCHEDULE=30 3 * * *

# ── REDIS (optional — for multi-instance deployments) ─────────
# If empty, falls back to in-memory storage (single instance only).
REDIS_URL=

# ── TELEGRAM (optional) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── OPEN TELEMETRY (optional — for distributed tracing) ──────
# OTLP HTTP endpoint (Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── SENTRY (optional — for error monitoring) ─────────────────
# Frontend DSN (from Sentry project settings → Client Keys)
VITE_SENTRY_DSN=
# Backend DSN (same project, different key)
SENTRY_DSN=
# Source maps upload + alerts setup (optional)
# SENTRY_ORG: your org slug (e.g., "my-company")
SENTRY_ORG=
# SENTRY_PROJECT: project slug (e.g., "warehouse-pro")
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN: generate at Settings → Auth Tokens → New Token
# Required scopes: event:admin, event:read, org:read, project:read, project:releases
SENTRY_AUTH_TOKEN=

# ── Sentry Alerts Setup ──────────────────────────────────────
# After setting the above variables, run:
#   node scripts/setup-sentry-alerts.mjs
# This creates 5 alert rules:
#   1. High Error Rate (>10 errors/min)
#   2. New Error Type Detected (first seen)
#   3. Server Error (500)
#   4. Slow API Response (P95 > 2s)
#   5. Auth Failure Spike (>5/min)
#
# Then configure notification channels in Sentry dashboard:
#   Settings → Alerts → Notification Actions → Add
